# Django Settings
DJANGO_SECRET_KEY=django-insecure-beraun-plantai-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,web

# PostgreSQL Settings
POSTGRES_DB=plantai_db
POSTGRES_USER=plantai_user
POSTGRES_PASSWORD=plantai_password
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql://plantai_user:plantai_password@db:5432/plantai_db

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# DeepSeek AI API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com

# ML Model Settings
ML_MODEL_PATH=/app/ml_models/plant_disease_model.pth
USE_MOCK_MODEL=True

# CORS
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173,http://localhost:80
